# Copy to .env (git-ignored) and fill in. Every key below is a PLACEHOLDER - never commit a real key.
# With LLM_PROVIDER=fake and EMBEDDING_PROVIDER=fake the whole stack runs offline with no keys.
# To go live, change ONLY this file: pick a real provider, set its key and model, then re-ingest.

APP_ENV=dev                               # dev | prod  (prod refuses weak/placeholder gateway keys)

# ---------- LLM (generation) ----------
LLM_PROVIDER=fake                         # fake | anthropic | openai | ollama
LLM_API_KEY=YOUR_LLM_API_KEY_HERE         # placeholder - never commit a real key
LLM_MODEL=YOUR_CHAT_MODEL_NAME_HERE       # placeholder - pick a current model id
LLM_BASE_URL=                             # optional: ollama (http://host.docker.internal:11434) or OpenAI-compatible URL
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# ---------- Embeddings (separate provider; Anthropic has no embeddings endpoint) ----------
EMBEDDING_PROVIDER=fake                   # fake | voyage | openai | sentence_transformers
EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY_HERE
EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL_NAME_HERE
EMBEDDING_DIM=1024                        # must match the model; changing it requires a full re-ingest

# ---------- Reranker (optional) ----------
RERANKER_PROVIDER=none                    # none | cohere | voyage | cross_encoder
RERANKER_API_KEY=YOUR_RERANKER_API_KEY_HERE

# ---------- Vector store ----------
VECTOR_STORE=qdrant                       # qdrant | memory
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=genzskool_kb

# ---------- Sessions ----------
SESSION_STORE=memory                      # memory | redis
REDIS_URL=                                # required only when SESSION_STORE=redis

# ---------- Service discovery (docker network names) ----------
INGESTION_URL=http://ingestion:8001
RETRIEVAL_URL=http://retrieval:8002
ADVISOR_URL=http://advisor:8003
EVALUATION_URL=http://evaluation:8004

# ---------- Gateway ----------
GATEWAY_API_KEY=YOUR_INTERNAL_GATEWAY_KEY_HERE   # clients send it as X-API-Key
ADMIN_API_KEY=YOUR_ADMIN_API_KEY_HERE            # required for /api/admin/* (sent as X-Admin-Key)
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=http://localhost:3000               # comma-separated allow-list; "*" is ignored

# ---------- Data ----------
PDF_DIR=/app/data/pdfs
PROCESSED_DIR=/app/data/processed
LOG_LEVEL=INFO
