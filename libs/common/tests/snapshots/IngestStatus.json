{
  "$defs": {
    "AutoIngestStatus": {
      "description": "State of the background auto-ingester (startup run + PDF folder watcher).",
      "properties": {
        "consecutive_failures": {
          "default": 0,
          "title": "Consecutive Failures",
          "type": "integer"
        },
        "last_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "last_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Ok"
        },
        "last_run_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Run At"
        },
        "last_trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutoIngestTrigger"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "on_startup": {
          "title": "On Startup",
          "type": "boolean"
        },
        "prune_deleted": {
          "title": "Prune Deleted",
          "type": "boolean"
        },
        "runs": {
          "default": 0,
          "title": "Runs",
          "type": "integer"
        },
        "watch_interval_s": {
          "description": "0 means the folder watcher is disabled.",
          "title": "Watch Interval S",
          "type": "number"
        }
      },
      "required": [
        "on_startup",
        "watch_interval_s",
        "prune_deleted"
      ],
      "title": "AutoIngestStatus",
      "type": "object"
    },
    "AutoIngestTrigger": {
      "enum": [
        "startup",
        "file_change",
        "index_drift",
        "retry"
      ],
      "title": "AutoIngestTrigger",
      "type": "string"
    },
    "DocumentStatus": {
      "properties": {
        "active_index_version": {
          "title": "Active Index Version",
          "type": "integer"
        },
        "chunks": {
          "title": "Chunks",
          "type": "integer"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "source_file": {
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "source_file",
        "content_hash",
        "active_index_version",
        "chunks",
        "ingested_at"
      ],
      "title": "DocumentStatus",
      "type": "object"
    }
  },
  "properties": {
    "auto_ingest": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutoIngestStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/DocumentStatus"
      },
      "title": "Documents",
      "type": "array"
    }
  },
  "required": [
    "documents"
  ],
  "title": "IngestStatus",
  "type": "object"
}
